{
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "installCommand": "yarn install",
  "devCommand": "next dev",
  "outputDirectory": ".next",
  "env": {
    "DATABASE_URL": "@database_url",
    "ABACUSAI_API_KEY": "@abacusai_api_key"
  },
  "build": {
    "env": {
      "DATABASE_URL": "@database_url",
      "ABACUSAI_API_KEY": "@abacusai_api_key"
    }
  },
  "functions": {
    "app/api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
