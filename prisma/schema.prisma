generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/phase_pilote_dashboard/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model SupervisionData {
  id                          String   @id @default(cuid())
  date                        DateTime
  etablissement               String
  sageFemmesFormees           Int      @default(0)
  sageFemmesPresentes         Int      @default(0)
  femmesEnceintesRecues       Int      @default(0)
  femmesEnceintesEnregistrees Int      @default(0)
  femmesEnceintesConnectees   Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([date, etablissement])
  @@index([date])
  @@index([etablissement])
}

model ApplicationData {
  id                          String   @id @default(cuid())
  date                        DateTime
  etablissement               String
  sageFemmesFormees           Int      @default(0)
  sageFemmesPresentes         Int      @default(0)
  femmesEnceintesRecues       Int      @default(0)
  femmesEnceintesEnregistrees Int      @default(0)
  femmesEnceintesConnectees   Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([date, etablissement])
  @@index([date])
  @@index([etablissement])
}

model DataRefreshLog {
  id          String   @id @default(cuid())
  source      String
  refreshedAt DateTime @default(now())
  recordCount Int
  status      String
}
